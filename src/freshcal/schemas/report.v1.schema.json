{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:freshcal:report:v1",
  "title": "FreshCal report, schema version 1.x",
  "type": "object",
  "required": [
    "schema_version",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "kind": {
      "enum": [
        "check",
        "next"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "check"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/checkReport"
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "next"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/nextReport"
      }
    }
  ],
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "local": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?[+-][0-9]{2}:[0-9]{2}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "ON_TIME",
        "NOT_DUE",
        "OVERDUE",
        "NO_DATA",
        "CONFIG_ERROR",
        "QUERY_ERROR"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "location"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[EW][0-9]{3}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instant",
        "local",
        "adjusted_from",
        "dst",
        "clamped"
      ],
      "properties": {
        "instant": {
          "$ref": "#/$defs/utc"
        },
        "local": {
          "$ref": "#/$defs/local"
        },
        "adjusted_from": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        },
        "dst": {
          "enum": [
            "normal",
            "gap",
            "ambiguous"
          ]
        },
        "clamped": {
          "type": "boolean"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instant",
        "raw",
        "was_naive",
        "interpreted_timezone"
      ],
      "properties": {
        "instant": {
          "$ref": "#/$defs/utc"
        },
        "raw": {
          "type": "string"
        },
        "was_naive": {
          "type": "boolean"
        },
        "interpreted_timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "origin",
        "status",
        "is_verdict",
        "schedule_timezone",
        "release",
        "deadline",
        "observed",
        "next_expected_arrival",
        "missed_count",
        "missed_truncated",
        "pending_count",
        "explanation",
        "warnings",
        "error"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "config",
            "dbt_manifest"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "is_verdict": {
          "type": "boolean"
        },
        "schedule_timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/release"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/utc"
            }
          ]
        },
        "observed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/observation"
            }
          ]
        },
        "next_expected_arrival": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/utc"
            }
          ]
        },
        "missed_count": {
          "type": "integer",
          "minimum": 0
        },
        "missed_truncated": {
          "type": "boolean"
        },
        "pending_count": {
          "type": "integer",
          "minimum": 0
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/issue"
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "ON_TIME",
        "NOT_DUE",
        "OVERDUE",
        "NO_DATA",
        "CONFIG_ERROR",
        "QUERY_ERROR"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ON_TIME": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_DUE": {
          "type": "integer",
          "minimum": 0
        },
        "OVERDUE": {
          "type": "integer",
          "minimum": 0
        },
        "NO_DATA": {
          "type": "integer",
          "minimum": 0
        },
        "CONFIG_ERROR": {
          "type": "integer",
          "minimum": 0
        },
        "QUERY_ERROR": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "freshcal_version",
        "evaluated_at",
        "exit_code",
        "summary",
        "results"
      ],
      "properties": {
        "schema_version": true,
        "kind": true,
        "freshcal_version": {
          "type": "string"
        },
        "evaluated_at": {
          "$ref": "#/$defs/utc"
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    "nextReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "freshcal_version",
        "evaluated_at",
        "sources"
      ],
      "properties": {
        "schema_version": true,
        "kind": true,
        "freshcal_version": {
          "type": "string"
        },
        "evaluated_at": {
          "$ref": "#/$defs/utc"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "schedule_timezone",
              "releases",
              "warnings",
              "error"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "schedule_timezone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "releases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "instant",
                    "local",
                    "deadline"
                  ],
                  "properties": {
                    "instant": {
                      "$ref": "#/$defs/utc"
                    },
                    "local": {
                      "$ref": "#/$defs/local"
                    },
                    "deadline": {
                      "$ref": "#/$defs/utc"
                    }
                  }
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/issue"
                }
              },
              "error": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/issue"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
